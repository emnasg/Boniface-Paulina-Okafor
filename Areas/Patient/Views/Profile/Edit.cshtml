@model Okafor_.NET.ViewModels.PatientProfileEditViewModel

@{
    ViewData["Title"] = "Change your details";
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">Your record</p>
    <h1 class="portal-page-title">Change your details</h1>
</div>

<div class="portal-form">
    <form asp-area="Patient" asp-controller="Profile" asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="portal-notice portal-notice--grave mb-4"></div>

        <div class="mb-4">
            <label asp-for="FullName" class="form-label">Full name</label>
            <input asp-for="FullName" class="form-control" autocomplete="name" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Phone" class="form-label">Telephone number</label>
            <input asp-for="Phone" class="form-control" type="tel" inputmode="tel" autocomplete="tel" />
            <span class="form-text d-block">This is how the hospital reaches you to confirm or move a visit.</span>
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>
        <div class="mb-4">
            <label asp-for="Address" class="form-label">Address</label>
            <textarea asp-for="Address" rows="3" class="form-control" autocomplete="street-address"></textarea>
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary">Save these details</button>
            <a asp-area="Patient" asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
