@model Okafor_.NET.Models.PatientProfile

@{
    ViewData["Title"] = "Your details";
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">Your record</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">Your details</h1>
        <a asp-area="Patient" asp-controller="Profile" asp-action="Edit" class="btn btn-outline-secondary">Change these details</a>
    </div>
</div>

<p class="portal-page-lede mb-4">
    Keep these current so the hospital can identify your record, and so staff can reach
    you to confirm or move an appointment.
</p>

<div class="portal-plate portal-measure">
    <dl class="portal-leaders mb-0">
        <div class="portal-lead">
            <dt class="portal-lead__k">Full name</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Model.FullName</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Telephone</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@(string.IsNullOrWhiteSpace(Model.Phone) ? "Not given" : Model.Phone)</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Address</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@(string.IsNullOrWhiteSpace(Model.Address) ? "Not given" : Model.Address)</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Registered</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Model.CreatedAt.ToString("d MMMM yyyy")</dd>
        </div>
    </dl>
</div>
