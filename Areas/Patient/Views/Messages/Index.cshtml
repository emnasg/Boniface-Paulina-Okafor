@model IEnumerable<Okafor_.NET.Models.PatientMessage>

@{
    ViewData["Title"] = "Messages";
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">Your</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">Messages</h1>
        <a asp-area="Patient" asp-controller="Messages" asp-action="Send" class="btn btn-primary btn-lead">Send a message</a>
    </div>
</div>

<div class="portal-notice portal-notice--grave mb-4">
    <p class="portal-notice__k">In an emergency</p>
    <p class="portal-notice__b">
        Call 112 or 199, or go straight to the hospital. Do not wait for a reply here.
    </p>
</div>

<p class="portal-page-lede mb-4">
    Hospital staff read every message you send. They answer by telephoning you or
    by writing to your email address — the answer will not appear on this page.
</p>

@if (!Model.Any())
{
    <div class="portal-empty">
        <div class="portal-fleuron"><span></span></div>
        <p class="portal-empty__h">You have not written yet</p>
        <p class="portal-empty__p">
            Use a message for anything that is not urgent — a question about a
            prescription, or a request to move an appointment.
        </p>
        <a asp-area="Patient" asp-controller="Messages" asp-action="Send" class="btn btn-primary btn-lead">Send a message</a>
    </div>
}
else
{
    <div class="portal-register">
        <div class="portal-register__cap">
            <h2 class="portal-register__capt">Messages you have sent</h2>
            <p class="portal-register__capn">Newest first</p>
        </div>

        @foreach (var msg in Model)
        {
            <div class="portal-register__row">
                <p class="portal-register__stamp">
                    <span class="portal-register__d">@msg.SentAt.ToString("dd")</span>
                    <span class="portal-register__m">@msg.SentAt.ToString("MMM yyyy")</span>
                </p>

                <div class="min-w-0">
                    <p class="portal-register__what">@msg.Subject</p>
                    <p class="portal-register__meta">You sent this at @msg.SentAt.ToString("h:mm tt")</p>
                    <p class="portal-register__next">@msg.Body</p>
                </div>

                <p class="mb-0">
                    <span class="portal-mark @(msg.IsRead ? "bg-success" : "bg-warning")">
                        @(msg.IsRead ? "Read by staff" : "Not read yet")
                    </span>
                </p>

                <div class="portal-register__acts"></div>
            </div>
        }
    </div>
}
