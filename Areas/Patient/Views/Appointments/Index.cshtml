@model IEnumerable<Okafor_.NET.ViewModels.PortalAppointmentViewModel>

@{
    ViewData["Title"] = "Appointments";

    bool CanAddToCalendar(Okafor_.NET.ViewModels.PortalAppointmentViewModel appointment) =>
        appointment.Date > DateTime.Now &&
        ((appointment.SourceType == "scheduled" && appointment.Status is "Scheduled" or "Confirmed") ||
         (appointment.SourceType == "request" && appointment.Status == "Approved"));

    bool CanCancel(Okafor_.NET.ViewModels.PortalAppointmentViewModel appointment) =>
        (appointment.SourceType == "request" && appointment.Status == "Pending") ||
        (appointment.SourceType == "scheduled" &&
         appointment.Date > DateTime.Now &&
         appointment.Status != "Completed" &&
         appointment.Status != "Cancelled");

    // booking-realtime.js writes these same class names when a status changes
    // live, and portal.css styles .portal-mark from them — so the mark stays
    // correct without the script knowing anything about this view.
    string MarkClass(string status) => status switch
    {
        "Confirmed" or "Approved" => "bg-success",
        "Completed"               => "bg-secondary",
        "Cancelled" or "Rejected" => "bg-danger",
        "Rescheduled"             => "bg-info",
        _                         => "bg-warning"
    };

    string NextStep(string status) => status switch
    {
        "Pending"  => "Hospital staff will contact you to confirm this date or offer another.",
        "Approved" or "Confirmed" or "Scheduled"
                   => "Arrive fifteen minutes early with your identification and any referral letters.",
        "Rejected" => "Telephone the hospital if you still need care or would like another date.",
        _          => string.Empty
    };

    var upcoming = Model.Count(a => a.Date > DateTime.Now);
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">Your</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">Appointments</h1>
        <a asp-area="" asp-controller="AppointmentRequests" asp-action="Create" class="btn btn-primary btn-lead">Ask for a visit</a>
    </div>
</div>

<div class="alert d-none" data-booking-realtime role="status" aria-live="polite"></div>

@if (!Model.Any())
{
    <div class="portal-empty">
        <div class="portal-fleuron"><span></span></div>
        <p class="portal-empty__h">You have no visit booked</p>
        <p class="portal-empty__p">
            When the hospital books a visit for you, the day, the time and the doctor
            you are seeing will appear here.
        </p>
        <a asp-area="" asp-controller="AppointmentRequests" asp-action="Create" class="btn btn-primary btn-lead">Ask for a visit</a>
    </div>
}
else
{
    <div class="portal-register">
        <div class="portal-register__cap">
            <h2 class="portal-register__capt">All your visits</h2>
            <p class="portal-register__capn">
                @(upcoming == 0 ? "None still to come" : upcoming == 1 ? "1 still to come" : $"{upcoming} still to come") &middot; newest first
            </p>
        </div>

        @foreach (var appt in Model)
        {
            var canCancel = CanCancel(appt);
            var canAddToCalendar = CanAddToCalendar(appt);
            var nextStep = NextStep(appt.Status);

            <div class="portal-register__row"
                 data-appointment-offline-item
                 data-appointment-id="@($"{appt.SourceType}:{appt.SourceId}")"
                 data-subject="@appt.Subject"
                 data-date="@appt.Date.ToString("o")"
                 data-department="@appt.Department"
                 data-doctor="@(appt.Doctor ?? "Unassigned")"
                 data-status="@appt.Status"
                 data-type="@appt.Source">

                <p class="portal-register__stamp">
                    <span class="portal-register__d">@appt.Date.ToString("dd")</span>
                    <span class="portal-register__m">@appt.Date.ToString("MMM yyyy")</span>
                </p>

                <div class="min-w-0">
                    <p class="portal-register__what">@appt.Department</p>
                    <p class="portal-register__meta">
                        @if (appt.Date.TimeOfDay != TimeSpan.Zero)
                        {
                            @appt.Date.ToString("h:mm tt")<text> &middot; </text>
                        }
                        @(appt.Doctor ?? "Doctor not chosen yet") &middot; @appt.Source
                    </p>
                    @if (!string.IsNullOrWhiteSpace(appt.Notes))
                    {
                        <p class="portal-register__meta">@appt.Notes</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(nextStep))
                    {
                        <p class="portal-register__next">@nextStep</p>
                    }
                </div>

                <p class="mb-0">
                    <span class="portal-mark @MarkClass(appt.Status)" data-booking-status="appointment:@appt.BookingStatusId">@appt.Status</span>
                </p>

                <div class="portal-register__acts">
                    @if (canAddToCalendar)
                    {
                        <a asp-area="Patient"
                           asp-controller="Appointments"
                           asp-action="DownloadCalendar"
                           asp-route-sourceType="@appt.SourceType"
                           asp-route-sourceId="@appt.SourceId"
                           class="portal-act">Add to my calendar</a>

                        <button type="button"
                                class="portal-act portal-act--button js-remind"
                                data-subject="@appt.Subject"
                                data-date="@appt.Date.ToString("o")"
                                data-appointment-id="@($"{appt.SourceType}:{appt.SourceId}")"
                                data-department="@appt.Department"
                                data-doctor="@(appt.Doctor ?? "Unassigned")"
                                data-status="@appt.Status"
                                data-type="@appt.Source">Remind me the day before</button>
                    }
                    @if (canCancel)
                    {
                        <form asp-area="Patient"
                              asp-controller="Appointments"
                              asp-action="Cancel"
                              method="post"
                              class="portal-act-form portal-act-form--grave"
                              onsubmit="return confirm('Are you sure you want to cancel this visit? Somebody else may take the time.');">
                            <input type="hidden" name="sourceType" value="@appt.SourceType" />
                            <input type="hidden" name="sourceId" value="@appt.SourceId" />
                            <button type="submit">Cancel this visit</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
}

@* The page's afterword, not its opening. Saving an offline copy is a useful
   thing to be offered and a strange thing to be asked before you have been
   shown the dates you came to read — which is where this block used to sit. *@
@if (Model.Any())
{
<div class="portal-aside mt-4">
    <div class="portal-register__cap">
        <h2 class="portal-register__capt">Keep a copy on this device</h2>
    </div>
    <p class="portal-page-lede mb-3">
        Saves the dates above onto this phone or computer, so you can still read them
        when there is no network. Nothing else from your file is saved — no notes, no
        messages, no documents, no bills.
    </p>
    <div class="d-flex flex-wrap gap-2">
        <button type="button" class="btn btn-outline-secondary" data-save-offline-appointments>Save a copy here</button>
        <a href="/offline-appointments.html" class="btn btn-outline-secondary">Read the saved copy</a>
    </div>
    <div class="alert d-none mt-3 mb-0" data-appointment-pwa-status role="status" aria-live="polite"></div>
</div>
}

@section Scripts {
    <script nonce="@(Context.Items["CspNonce"])" src="~/js/pwa-appointments.js" asp-append-version="true"></script>
}
