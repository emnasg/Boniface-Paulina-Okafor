@model Okafor_.NET.Areas.Patient.Controllers.PatientDashboardViewModel
@inject Okafor_.NET.Services.ILaunchFeatureAvailability LaunchFeatures
@{
    ViewData["Title"] = "Home";

    var documentsEnabled = LaunchFeatures.IsEnabled(Okafor_.NET.Services.LaunchFeature.PatientDocuments);
    var visit = Model.NextVisit;

    // The same status vocabulary the register and booking-realtime.js use, so a
    // live update recolours the mark without any special case here.
    string MarkClass(string status) => status switch
    {
        "Confirmed" or "Approved" => "bg-success",
        "Completed"               => "bg-secondary",
        "Cancelled" or "Rejected" => "bg-danger",
        "Rescheduled"             => "bg-info",
        _                         => "bg-warning"
    };

    // A booking request carries no time until staff set one, in which case
    // PortalAppointmentTime.Combine leaves it at midnight. Printing "12:00 AM"
    // would read as a real appointment at midnight, so say what is true instead.
    var hasTime = visit is not null && visit.Date.TimeOfDay != TimeSpan.Zero;

    // Every row of the index says what it is in a plain sentence and what is in
    // it in plain words. A lone figure in a column — "2", "0" — tells a reader
    // nothing about what it counts or whether it needs them.
    string Count(int number, string ofWhat) =>
        number == 0 ? "None" : $"{number} {ofWhat}";

    // Before a patient file exists the controller falls back to the username,
    // which is the email address they registered with. Set at page-title size
    // that is a 40-character string where a name should be, and on a phone it
    // pushed the whole page sideways.
    var heading = Model.HasProfile ? Model.PatientName : "Welcome";
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">Your health record</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">@heading</h1>
        <a asp-area="" asp-controller="AppointmentRequests" asp-action="Create" class="btn btn-primary btn-lead">Ask for a visit</a>
    </div>
</div>

<div class="alert d-none" data-booking-realtime role="status" aria-live="polite"></div>

@if (!Model.HasProfile)
{
    <div class="portal-plate mb-4">
        <p class="portal-plate__label">Please do this first</p>
        <p class="portal-plate__dow">We do not have your details yet</p>
        <p class="portal-plate__prep">
            Tell us your name and telephone number so the hospital can put your
            appointments, messages and documents in the right file. It takes a minute.
        </p>
        <div class="portal-plate__acts">
            <a asp-area="Patient" asp-controller="Profile" asp-action="Create" class="btn btn-primary btn-lead">Add my details</a>
        </div>
    </div>
}
else if (visit is not null)
{
    var pending = visit.Status is "Pending";

    <div class="portal-plate @(pending ? "portal-plate--quiet" : string.Empty) mb-4">
        <p class="portal-plate__label">@(pending ? "You asked for a visit" : "Your next visit")</p>

        @if (pending)
        {
            <p class="portal-plate__dow">You asked for @visit.Date.ToString("dddd d MMMM")</p>
            <p class="portal-plate__date portal-plate__date--none">&mdash;</p>
            <p class="portal-plate__hour portal-plate__hour--none">The hospital has not set a date yet</p>
        }
        else
        {
            <p class="portal-plate__dow">@visit.Date.ToString("dddd")</p>
            <p class="portal-plate__date">@visit.Date.ToString("d MMMM")</p>
            <p class="portal-plate__hour">
                @if (hasTime)
                {
                    @visit.Date.ToString("h:mm tt")
                }
                else
                {
                    <text>We will tell you the time</text>
                }
            </p>
        }

        <dl class="portal-leaders portal-plate__ledger">
            <div class="portal-lead">
                <dt class="portal-lead__k">Where</dt>
                <dd class="portal-lead__fill"></dd>
                <dd class="portal-lead__v">@visit.Department</dd>
            </div>
            <div class="portal-lead">
                <dt class="portal-lead__k">Doctor</dt>
                <dd class="portal-lead__fill"></dd>
                <dd class="portal-lead__v">@(visit.Doctor ?? "Not chosen yet")</dd>
            </div>
            <div class="portal-lead">
                <dt class="portal-lead__k">Status</dt>
                <dd class="portal-lead__fill"></dd>
                <dd class="portal-lead__v">
                    <span class="portal-mark @MarkClass(visit.Status)" data-booking-status="appointment:@visit.BookingStatusId">@visit.Status</span>
                </dd>
            </div>
        </dl>

        <p class="portal-plate__prep">
            @if (pending)
            {
                <text>
                    The hospital will telephone you on the number in your details. They
                    will either agree this date or offer you another one. You do not
                    need to do anything now.
                </text>
            }
            else
            {
                <text>
                    Please come fifteen minutes early. Bring something with your name on
                    it and any letter your doctor gave you.
                </text>
            }
        </p>

        <div class="portal-plate__acts">
            <a asp-area="Patient" asp-controller="Appointments" asp-action="Index" class="btn btn-primary btn-lead">See this visit</a>
        </div>
    </div>
}
else
{
    <div class="portal-empty mb-4">
        <div class="portal-fleuron"><span></span></div>
        <p class="portal-empty__h">You have no visit booked</p>
        <p class="portal-empty__p">
            When the hospital books a visit for you, the day, the time and the doctor
            you are seeing will appear here.
        </p>
        <a asp-area="" asp-controller="AppointmentRequests" asp-action="Create" class="btn btn-primary btn-lead">Ask for a visit</a>
    </div>
}

<h2 class="visually-hidden">The rest of your record</h2>
<div class="portal-index">
    <a class="portal-index__row" asp-area="Patient" asp-controller="Appointments" asp-action="Index">
        <span class="portal-index__t">
            <span class="portal-index__k">Appointments</span>
            <span class="portal-index__say">Every visit to the hospital, past and future</span>
        </span>
        <span class="portal-index__v @(Model.UpcomingAppointmentsCount == 0 ? "portal-index__v--none" : string.Empty)">
            @Count(Model.UpcomingAppointmentsCount, "coming up")
        </span>
        <span class="portal-index__go" aria-hidden="true">&rsaquo;</span>
    </a>

    <a class="portal-index__row" asp-area="Patient" asp-controller="Teleconsultations" asp-action="Index">
        <span class="portal-index__t">
            <span class="portal-index__k">Teleconsultations</span>
            <span class="portal-index__say">Seeing a doctor by video or telephone, without coming in</span>
        </span>
        <span class="portal-index__v @(Model.PendingTeleconsultationsCount == 0 ? "portal-index__v--none" : string.Empty)">
            @Count(Model.PendingTeleconsultationsCount, "being arranged")
        </span>
        <span class="portal-index__go" aria-hidden="true">&rsaquo;</span>
    </a>

    <a class="portal-index__row" asp-area="Patient" asp-controller="Messages" asp-action="Index">
        <span class="portal-index__t">
            <span class="portal-index__k">Messages</span>
            <span class="portal-index__say">Write to the hospital. Staff answer by telephone or email</span>
        </span>
        <span class="portal-index__v @(Model.MessagesAwaitingReviewCount == 0 ? "portal-index__v--none" : string.Empty)">
            @Count(Model.MessagesAwaitingReviewCount, "not read yet")
        </span>
        <span class="portal-index__go" aria-hidden="true">&rsaquo;</span>
    </a>

    @if (documentsEnabled)
    {
        <a class="portal-index__row" asp-area="Patient" asp-controller="Documents" asp-action="Index">
            <span class="portal-index__t">
                <span class="portal-index__k">Documents</span>
                <span class="portal-index__say">Test results and letters kept in your file</span>
            </span>
            <span class="portal-index__v @(Model.PendingDocumentsCount == 0 ? "portal-index__v--none" : string.Empty)">
                @Count(Model.PendingDocumentsCount, "on file")
            </span>
            <span class="portal-index__go" aria-hidden="true">&rsaquo;</span>
        </a>
    }

    <a class="portal-index__row" asp-area="Patient" asp-controller="Profile" asp-action="Index">
        <span class="portal-index__t">
            <span class="portal-index__k">Your details</span>
            <span class="portal-index__say">Your name, telephone number and address</span>
        </span>
        <span class="portal-index__v portal-index__v--none">Check them</span>
        <span class="portal-index__go" aria-hidden="true">&rsaquo;</span>
    </a>
</div>

<div class="portal-aside mt-4">
    @await Component.InvokeAsync("PushNotifications")
</div>

@section Scripts {
    <script nonce="@(Context.Items["CspNonce"])" src="~/js/push-notifications.js" asp-append-version="true"></script>
}
