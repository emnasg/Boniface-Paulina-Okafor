@model Okafor_.NET.ViewModels.PatientDocumentUploadViewModel

@{
    ViewData["Title"] = "Upload a document";
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">Documents</p>
    <h1 class="portal-page-title">Upload a document</h1>
</div>

<div class="portal-form">
    <p class="portal-page-lede mb-4">
        Share a referral, a test result, a prescription, or any other record relevant to
        your care.
    </p>

    <div class="portal-notice mb-4">
        <p class="portal-notice__k">What you can upload</p>
        <p class="portal-notice__b">
            Your own health information only. PDF, JPG, PNG, DOC or DOCX files, up to 10 MB
            each.
        </p>
    </div>

    <form asp-area="Patient"
          asp-controller="Documents"
          asp-action="Upload"
          method="post"
          enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="portal-notice portal-notice--grave mb-4"></div>

        <div class="mb-4">
            <label asp-for="Title" class="form-label">What is this document?</label>
            <input asp-for="Title" class="form-control" autocomplete="off" placeholder="For example, blood test result" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Description" class="form-label">Anything staff should know</label>
            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional short note"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="File" class="form-label">Choose the file</label>
            <input asp-for="File" class="form-control" type="file" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" />
            <span asp-validation-for="File" class="text-danger"></span>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary">Upload securely</button>
            <a asp-area="Patient" asp-controller="Documents" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
