@model IEnumerable<Okafor_.NET.Models.PatientDocument>

@{
    ViewData["Title"] = "Documents";

    static string Extension(string? title)
    {
        var suffix = System.IO.Path.GetExtension(title ?? string.Empty).TrimStart('.');
        return string.IsNullOrWhiteSpace(suffix) ? "DOC" : suffix.ToUpperInvariant();
    }
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">Your</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">Documents</h1>
        @if (ViewBag.HasProfile != false)
        {
            <a asp-area="Patient" asp-controller="Documents" asp-action="Upload" class="btn btn-primary btn-lead">Add a document</a>
        }
    </div>
</div>

@if (ViewBag.HasProfile == false)
{
    <div class="portal-notice portal-notice--info">
        <p class="portal-notice__k">Not ready yet</p>
        <p class="portal-notice__b">
            The hospital has not linked your account to a patient file yet, so there is
            nowhere to keep your documents. Telephone the hospital office and they
            will do it for you.
        </p>
    </div>
}
else if (!Model.Any())
{
    <div class="portal-empty">
        <div class="portal-fleuron"><span></span></div>
        <p class="portal-empty__h">No documents yet</p>
        <p class="portal-empty__p">
            Letters, test results and prescriptions the hospital keeps for you will
            appear here, along with anything you add yourself.
        </p>
        <a asp-area="Patient" asp-controller="Documents" asp-action="Upload" class="btn btn-primary btn-lead">Add your first document</a>
    </div>
}
else
{
    <p class="portal-page-lede mb-4">
        Records the hospital has filed for @(ViewBag.PatientName ?? "your account"), and
        anything you have shared with them.
    </p>

    <div>
        @foreach (var doc in Model)
        {
            <div class="portal-doc">
                <span class="portal-doc__mark" aria-hidden="true">@Extension(doc.Title)</span>
                <div class="portal-doc__body">
                    <p class="portal-doc__t">@doc.Title</p>
                    @if (!string.IsNullOrWhiteSpace(doc.Description))
                    {
                        <p class="portal-doc__m">@doc.Description</p>
                    }
                    <p class="portal-doc__m">Filed @doc.UploadedAt.ToString("d MMMM yyyy")</p>
                </div>
                <a asp-area="Patient"
                   asp-controller="Documents"
                   asp-action="Download"
                   asp-route-id="@doc.Id"
                   target="_blank"
                   rel="noopener"
                   class="portal-act">Open this document</a>
            </div>
        }
    </div>
}
