@model IEnumerable<Okafor_.NET.ViewModels.PortalTeleconsultationViewModel>

@{
    ViewData["Title"] = "Teleconsultations";

    string MarkClass(string status) => status switch
    {
        "Confirmed"               => "bg-success",
        "Completed"               => "bg-secondary",
        "Cancelled" or "Rejected" => "bg-danger",
        "Rescheduled"             => "bg-info",
        _                         => "bg-warning"
    };

    string NextStep(string status) => status switch
    {
        "Pending"     => "The hospital will look at this and contact you. You do not need to do anything now.",
        "Confirmed"   => "When the hospital sets up the call, a button to join it will appear on this line.",
        "Rescheduled" => "The hospital has moved this. The new day is shown on the left.",
        _             => string.Empty
    };

    // Stored as "14:00". Said aloud as half past two in the afternoon, and read
    // that way by anyone who does not count the hours past twelve.
    string Spoken(string? time) =>
        DateTime.TryParse(time, out var parsed) ? parsed.ToString("h:mm tt") : (time ?? string.Empty);

    string TypeLabel(string type) => type switch
    {
        "FollowUp" => "Follow-up",
        _          => type
    };
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">Your</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">Teleconsultations</h1>
        <a asp-area="" asp-controller="Teleconsultations" asp-action="Create" class="btn btn-primary btn-lead">Ask for a teleconsultation</a>
    </div>
</div>

<p class="portal-page-lede mb-4">
    A teleconsultation is seeing a doctor by video call or by telephone, from home,
    without travelling to the hospital.
</p>

<div class="alert d-none" data-booking-realtime role="status" aria-live="polite"></div>

@if (!Model.Any())
{
    <div class="portal-empty">
        <div class="portal-fleuron"><span></span></div>
        <p class="portal-empty__h">You have not had a teleconsultation yet</p>
        <p class="portal-empty__p">
            A teleconsultation lets you speak to a doctor by video or telephone without
            travelling to the hospital. Request one and staff will arrange a time.
        </p>
        <a asp-area="" asp-controller="Teleconsultations" asp-action="Create" class="btn btn-primary btn-lead">Ask for a teleconsultation</a>
    </div>
}
else
{
    <div class="portal-register">
        <div class="portal-register__cap">
            <h2 class="portal-register__capt">All your teleconsultations</h2>
            <p class="portal-register__capn">Newest first</p>
        </div>

        @foreach (var item in Model)
        {
            var canCancel = item.Status == "Pending";
            var meetingLink = IsSafeMeetingLink(item.MeetingLink) ? item.MeetingLink : null;
            var nextStep = NextStep(item.Status);

            <div class="portal-register__row">
                <p class="portal-register__stamp">
                    <span class="portal-register__d">@item.PreferredDate.ToString("dd")</span>
                    <span class="portal-register__m">@item.PreferredDate.ToString("MMM yyyy")</span>
                </p>

                <div class="min-w-0">
                    <p class="portal-register__what">@item.Department</p>
                    <p class="portal-register__meta">
                        @if (!string.IsNullOrWhiteSpace(item.PreferredTime))
                        {
                            @Spoken(item.PreferredTime)<text> &middot; </text>
                        }
                        @(item.Doctor ?? "Doctor not chosen yet") &middot; @TypeLabel(item.ConsultationType)
                    </p>
                    @if (!string.IsNullOrWhiteSpace(item.AdminNotes))
                    {
                        <p class="portal-register__meta">@item.AdminNotes</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(nextStep))
                    {
                        <p class="portal-register__next">@nextStep</p>
                    }
                    @if (item.WhatsAppOptIn)
                    {
                        <p class="portal-register__next">You asked to be updated on WhatsApp.</p>
                    }
                </div>

                <p class="mb-0">
                    <span class="portal-mark @MarkClass(item.Status)" data-booking-status="teleconsultation:@item.Id">@item.Status</span>
                </p>

                <div class="portal-register__acts">
                    @if (meetingLink is not null)
                    {
                        <a href="@meetingLink" target="_blank" rel="noopener" class="btn btn-primary">Join the call now</a>
                    }
                    @if (canCancel)
                    {
                        <form asp-area="Patient"
                              asp-controller="Teleconsultations"
                              asp-action="Cancel"
                              asp-route-id="@item.Id"
                              method="post"
                              class="portal-act-form portal-act-form--grave"
                              onsubmit="return confirm('Are you sure you no longer want this teleconsultation?');">
                            <button type="submit">Cancel this request</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
}

@functions {
    private static bool IsSafeMeetingLink(string? meetingLink)
    {
        if (!Uri.TryCreate(meetingLink, UriKind.Absolute, out var uri))
        {
            return false;
        }

        return uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp;
    }
}
