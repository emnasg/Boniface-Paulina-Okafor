@* Identity pages use the public layout, which no longer carries jQuery, so the
   validation scripts have to bring their own here too. *@
<script nonce="@(Context.Items["CspNonce"])" src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
<script nonce="@(Context.Items["CspNonce"])" src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script nonce="@(Context.Items["CspNonce"])" src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
