@model Okafor_.NET.ViewModels.CmsPostViewModel

@{
    ViewData["Title"] = "Edit a post";
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">The hospital</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">Edit a post</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to the posts</a>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <input asp-for="Id" type="hidden" />
    <input asp-for="CreatedAt" type="hidden" />
    <input asp-for="ExistingThumbnailUrl" type="hidden" />

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="mb-3">
                <label asp-for="Title" class="form-label">Title</label>
                <input asp-for="Title" class="form-control" maxlength="120" autocomplete="off" />
                <div class="form-text">
                    Write for one real patient or community question. Avoid vague
                    titles and lists of keywords.
                </div>
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Slug" class="form-label">Address on the site</label>
                <div class="input-group">
                    <span class="input-group-text">/news/</span>
                    <input asp-for="Slug" class="form-control" maxlength="220"
                           pattern="[a-z0-9]+(?:-[a-z0-9]+)*" autocomplete="off" />
                </div>
                <div class="form-text">Changing this breaks every link that already points at this post.</div>
                <span asp-validation-for="Slug" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Summary" class="form-label">Summary</label>
                <textarea asp-for="Summary" class="form-control" rows="3" maxlength="300"
                          aria-describedby="summary-help"></textarea>
                <div id="summary-help" class="form-text">
                    Used in search results and when the post is shared. Be specific;
                    do not repeat the title.
                    <span class="float-end"><span data-character-count-for="Summary">0</span>/300</span>
                </div>
                <span asp-validation-for="Summary" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Content" class="form-label">The post</label>
                <textarea asp-for="Content" class="form-control font-monospace" rows="18"
                          aria-describedby="content-help"></textarea>
                <div id="content-help" class="form-text">
                    Blank lines make paragraphs. End a short line with <code>:</code>
                    for a heading. Start lines with <code>-</code> for bullets or
                    <code>1.</code> for numbered steps.
                </div>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>

            @if (Model.Content.Contains('<', StringComparison.Ordinal))
            {
                <div class="portal-notice portal-notice--grave mb-4">
                    <p class="portal-notice__k">This post still contains HTML tags</p>
                    <p class="portal-notice__b">
                        The public page strips unsafe markup before it renders, so
                        nothing is at risk. Remove the tags as you revise the copy.
                    </p>
                </div>
            }
        </div>

        <div class="col-12 col-lg-4">
            <fieldset class="mb-4">
                <legend class="portal-legend">Publishing</legend>

                <div class="form-check mb-2">
                    <input asp-for="Published" class="form-check-input" type="checkbox" />
                    <label asp-for="Published" class="form-check-label">Published</label>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="IsFeatured" class="form-check-input" type="checkbox" />
                    <label asp-for="IsFeatured" class="form-check-label">Featured on the homepage</label>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Save these changes</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>

                <dl class="portal-leaders mt-3">
                    <div class="portal-lead">
                        <dt class="portal-lead__k">Written</dt>
                        <dd class="portal-lead__fill"></dd>
                        <dd class="portal-lead__v">@Model.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</dd>
                    </div>
                </dl>
            </fieldset>

            <fieldset class="mb-4">
                <legend class="portal-legend">Picture</legend>

                @if (!string.IsNullOrEmpty(Model.ExistingThumbnailUrl))
                {
                    <img src="@Model.ExistingThumbnailUrl" alt="The thumbnail on this post now"
                         class="mb-3" style="max-height:160px;object-fit:cover;" />
                    <label asp-for="Thumbnail" class="form-label">Replace the thumbnail</label>
                }
                else
                {
                    <label asp-for="Thumbnail" class="form-label">Thumbnail</label>
                }
                <input asp-for="Thumbnail" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                <div class="form-text">JPG, JPEG, PNG or WebP, up to 5 MB.</div>
                <span asp-validation-for="Thumbnail" class="text-danger"></span>
            </fieldset>

            <div class="portal-notice">
                <p class="portal-notice__k">Before you publish</p>
                <ul class="portal-notice__b mb-0 ps-3">
                    <li>Reconfirm dates, services, prices, staffing and contact details.</li>
                    <li>Name the source or the reviewer for any medical guidance.</li>
                    <li>Remove anything that identifies a patient unless permission is on record.</li>
                    <li>Keep the next step clear.</li>
                </ul>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script nonce="@(Context.Items["CspNonce"])">
        var summaryEl = document.getElementById('Summary');
        var summaryCountEl = document.querySelector('[data-character-count-for="Summary"]');

        function updateSummaryCount() {
            summaryCountEl.textContent = summaryEl.value.length;
        }

        summaryEl.addEventListener('input', updateSummaryCount);
        updateSummaryCount();
    </script>
}
