@model IEnumerable<Okafor_.NET.Models.Post>

@{
    ViewData["Title"] = "News posts";

    var published = Model.Count(post => post.Published);
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">The hospital</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">News posts</h1>
        <a asp-action="Create" class="btn btn-primary">Write a post</a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="portal-empty">
        <div class="portal-fleuron"><span></span></div>
        <p class="portal-empty__h">Nothing has been written yet</p>
        <p class="portal-empty__p">
            Posts appear on the news page of the public site once they are
            published. A draft stays here until you publish it.
        </p>
        <a asp-action="Create" class="btn btn-primary">Write the first one</a>
    </div>
}
else
{
    <div class="portal-register portal-register--titled">
        <div class="portal-register__cap">
            <h2 class="portal-register__capt">Register of posts</h2>
            <p class="portal-register__capn">
                @published published &middot;
                @(Model.Count() - published) still in draft
            </p>
        </div>

        @foreach (var post in Model)
        {
            <div class="portal-register__row">
                <div class="min-w-0">
                    <p class="portal-register__what">@post.Title</p>
                    @if (!string.IsNullOrWhiteSpace(post.Summary))
                    {
                        <p class="portal-register__meta">
                            @(post.Summary.Length > 120 ? post.Summary[..120] + "…" : post.Summary)
                        </p>
                    }
                    <p class="portal-register__sub">
                        /news/@post.Slug &middot; written @post.CreatedAt.ToLocalTime().ToString("d MMM yyyy")
                    </p>
                </div>

                <p class="mb-0">
                    <span class="portal-mark @(post.Published ? "bg-success" : "bg-secondary")">
                        @(post.Published ? "Published" : "Draft")
                    </span>
                    @if (post.IsFeatured)
                    {
                        <span class="portal-mark bg-warning d-block mt-1">On the homepage</span>
                    }
                </p>

                <div class="portal-register__acts">
                    <a asp-action="Edit" asp-route-id="@post.Id" class="portal-act">Edit</a>

                    <form asp-action="TogglePublish" asp-route-id="@post.Id" method="post" class="portal-act-form">
                        <button type="submit">@(post.Published ? "Unpublish" : "Publish")</button>
                    </form>

                    <form asp-action="ToggleFeatured" asp-route-id="@post.Id" method="post" class="portal-act-form">
                        <button type="submit">@(post.IsFeatured ? "Take off the homepage" : "Feature")</button>
                    </form>

                    <form asp-action="Delete" asp-route-id="@post.Id" method="post" class="portal-act-form portal-act-form--grave"
                          onsubmit="return confirm('Delete &quot;@post.Title&quot;? This cannot be undone.')">
                        <button type="submit">Delete</button>
                    </form>
                </div>
            </div>
        }
    </div>
}
