@model Okafor_.NET.ViewModels.CmsPostViewModel

@{
    ViewData["Title"] = "Write a post";
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">The hospital</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">Write a post</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to the posts</a>
    </div>
</div>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="mb-3">
                <label asp-for="Title" class="form-label">Title</label>
                <input asp-for="Title" id="Title" class="form-control" maxlength="120"
                       placeholder="A specific title that says what changed or what a reader will learn"
                       autocomplete="off" />
                <div class="form-text">
                    Write for one real patient or community question. Avoid vague
                    titles and lists of keywords.
                </div>
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Slug" class="form-label">Address on the site</label>
                <div class="input-group">
                    <span class="input-group-text">/news/</span>
                    <input asp-for="Slug" id="Slug" class="form-control" maxlength="220"
                           pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="post-slug" autocomplete="off" />
                </div>
                <div class="form-text">Written for you from the title. Change it before publishing if you want to.</div>
                <span asp-validation-for="Slug" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Summary" class="form-label">Summary</label>
                <textarea asp-for="Summary" class="form-control" rows="3" maxlength="300"
                          aria-describedby="summary-help"
                          placeholder="One natural sentence saying why this note is useful."></textarea>
                <div id="summary-help" class="form-text">
                    Used in search results and when the post is shared. Be specific;
                    do not repeat the title.
                    <span class="float-end"><span data-character-count-for="Summary">0</span>/300</span>
                </div>
                <span asp-validation-for="Summary" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Content" class="form-label">The post</label>
                <textarea asp-for="Content" class="form-control font-monospace" rows="18"
                          aria-describedby="content-help"
                          placeholder="Write the note in plain language..."></textarea>
                <div id="content-help" class="form-text">
                    Blank lines make paragraphs. End a short line with <code>:</code>
                    for a heading. Start lines with <code>-</code> for bullets or
                    <code>1.</code> for numbered steps. A short post is welcome when
                    it answers the question completely.
                </div>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <fieldset class="mb-4">
                <legend class="portal-legend">Publishing</legend>

                <div class="form-check mb-2">
                    <input asp-for="Published" class="form-check-input" type="checkbox" />
                    <label asp-for="Published" class="form-check-label">Publish it now</label>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="IsFeatured" class="form-check-input" type="checkbox" />
                    <label asp-for="IsFeatured" class="form-check-label">Feature it on the homepage</label>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Save this post</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </fieldset>

            <fieldset class="mb-4">
                <legend class="portal-legend">Picture</legend>

                <label asp-for="Thumbnail" class="form-label">Thumbnail</label>
                <input asp-for="Thumbnail" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                <div class="form-text">JPG, JPEG, PNG or WebP, up to 5 MB.</div>
                <span asp-validation-for="Thumbnail" class="text-danger"></span>
            </fieldset>

            <div class="portal-notice">
                <p class="portal-notice__k">Before you publish</p>
                <ul class="portal-notice__b mb-0 ps-3">
                    <li>Confirm dates, services, prices, staffing and contact details.</li>
                    <li>Name the source or the reviewer for any medical guidance.</li>
                    <li>Leave out anything that identifies a patient unless permission is on record.</li>
                    <li>Make the next step clear: call, contact, or request an appointment.</li>
                </ul>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script nonce="@(Context.Items["CspNonce"])">
        var titleEl = document.getElementById('Title');
        var slugEl = document.getElementById('Slug');
        var summaryEl = document.getElementById('Summary');
        var summaryCountEl = document.querySelector('[data-character-count-for="Summary"]');

        function toSlug(text) {
            return text.toLowerCase().trim()
                .replace(/[^a-z0-9\s-]/g, '')
                .replace(/\s+/g, '-')
                .replace(/-+/g, '-')
                .replace(/^-|-$/g, '');
        }

        titleEl.addEventListener('input', function () {
            if (!slugEl.dataset.userEdited) {
                slugEl.value = toSlug(this.value);
            }
        });

        slugEl.addEventListener('input', function () {
            this.dataset.userEdited = '1';
        });

        function updateSummaryCount() {
            summaryCountEl.textContent = summaryEl.value.length;
        }

        summaryEl.addEventListener('input', updateSummaryCount);
        updateSummaryCount();
    </script>
}
