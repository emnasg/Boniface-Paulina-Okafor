@{
    ViewData["Title"] = "Consulting hours";

    var doctors = (List<Doctor>)ViewBag.Doctors;
    var recentLogs = (List<NotificationLog>)ViewBag.RecentLogs;
}

@* This page was written in Tailwind classes, but the admin layout has only ever
   loaded Bootstrap and portal.css — so every one of them was inert and the page
   rendered as unstyled controls on a bare ground. It is built from the portal's
   own components now. The Alpine behaviour underneath is unchanged. *@

@section Styles {
    @* Alpine is deferred, so anything x-show would hide is briefly visible
       before it initialises. x-cloak holds those parts back until it does. *@
    <style>
        [x-cloak] { display: none !important; }
    </style>
}

<div x-data="availabilityManager()">

    <div class="portal-title">
        <div class="portal-title__rule"></div>
        <p class="portal-title__eyebrow">The hospital</p>
        <div class="portal-title__row">
            <h1 class="portal-page-title">Consulting hours</h1>
        </div>
        <p class="portal-page-lede">
            The week a doctor normally works, and the appointment slots generated
            from it. A patient can only book a slot that exists here.
        </p>
    </div>

    <div class="portal-notice mb-4"
         x-show="statusMsg"
         x-cloak
         x-transition
         :class="statusOk ? 'portal-notice--good' : 'portal-notice--grave'"
         role="status"
         aria-live="polite">
        <p class="portal-notice__k" x-text="statusOk ? 'Done' : 'That did not work'"></p>
        <p class="portal-notice__b" x-text="statusMsg"></p>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-4">
            <div class="mb-4">
                <label for="availability-doctor" class="form-label">Doctor</label>
                <select id="availability-doctor" class="form-select"
                        x-model="selectedDoctorId" @@change="loadAvailability()">
                    <option value="">Choose a doctor</option>
                    @foreach (var doctor in doctors)
                    {
                        <option value="@doctor.Id">@doctor.FullName</option>
                    }
                </select>
            </div>

            <fieldset>
                <legend class="portal-legend">Generate slots</legend>

                <p class="portal-register__meta mb-3">
                    Turns the week below into bookable appointment slots across a
                    range of dates. Existing slots are left alone.
                </p>

                <div class="mb-3">
                    <label for="generate-from" class="form-label">From</label>
                    <input id="generate-from" type="date" class="form-control" x-model="generateFrom" />
                </div>

                <div class="mb-3">
                    <label for="generate-to" class="form-label">To</label>
                    <input id="generate-to" type="date" class="form-control" x-model="generateTo" />
                </div>

                <button type="button" class="btn btn-outline-primary w-100"
                        @@click="generateSlots()"
                        :disabled="!selectedDoctorId || generating"
                        x-text="generating ? 'Generating…' : 'Generate the slots'">Generate the slots</button>
            </fieldset>
        </div>

        <div class="col-12 col-lg-8">
            <div class="portal-register__cap mb-3">
                <h2 class="portal-register__capt">The working week</h2>
                <p class="portal-register__capn" x-show="selectedDoctorId" x-cloak>Saved against the chosen doctor</p>
            </div>

            <div x-show="!selectedDoctorId">
                <div class="portal-empty">
                    <div class="portal-fleuron"><span></span></div>
                    <p class="portal-empty__h">Choose a doctor first</p>
                    <p class="portal-empty__p">
                        Each doctor keeps their own week. Choosing one loads the hours
                        already saved for them, or Monday to Friday if there are none.
                    </p>
                </div>
            </div>

            <div x-show="selectedDoctorId" x-cloak>
                <div class="portal-shift-head" aria-hidden="true">
                    <p>Day</p>
                    <p>Working</p>
                    <p>From</p>
                    <p>Until</p>
                    <p>Each visit</p>
                </div>

                <template x-for="(day, index) in schedule" :key="index">
                    <div class="portal-shift" :class="day.isActive ? '' : 'portal-shift--off'">
                        <p class="portal-shift__day" x-text="day.label"></p>

                        <div class="form-check">
                            <input type="checkbox" class="form-check-input"
                                   :id="'shift-active-' + index"
                                   x-model="day.isActive" />
                            <label class="form-check-label" :for="'shift-active-' + index"
                                   x-text="day.isActive ? 'Working' : 'Not working'"></label>
                        </div>

                        <div class="portal-shift__field">
                            <label class="portal-shift__k" :for="'shift-start-' + index">From</label>
                            <input type="time" class="form-control" :id="'shift-start-' + index"
                                   x-model="day.startTime" :disabled="!day.isActive" />
                        </div>

                        <div class="portal-shift__field">
                            <label class="portal-shift__k" :for="'shift-end-' + index">Until</label>
                            <input type="time" class="form-control" :id="'shift-end-' + index"
                                   x-model="day.endTime" :disabled="!day.isActive" />
                        </div>

                        <div class="portal-shift__field">
                            <label class="portal-shift__k" :for="'shift-slot-' + index">Each visit</label>
                            <select class="form-select" :id="'shift-slot-' + index"
                                    x-model="day.slotDurationMinutes" :disabled="!day.isActive">
                                <option value="15">15 minutes</option>
                                <option value="20">20 minutes</option>
                                <option value="30">30 minutes</option>
                                <option value="45">45 minutes</option>
                                <option value="60">60 minutes</option>
                            </select>
                        </div>
                    </div>
                </template>

                <div class="mt-4">
                    <button type="button" class="btn btn-primary"
                            @@click="saveAvailability()"
                            :disabled="!selectedDoctorId || saving"
                            x-text="saving ? 'Saving…' : 'Save this week'">Save this week</button>
                </div>
            </div>
        </div>
    </div>

    <div class="portal-register mt-5">
        <div class="portal-register__cap">
            <h2 class="portal-register__capt">The last ten messages we sent</h2>
            <p class="portal-register__capn">Across every appointment and teleconsultation</p>
        </div>

        @if (recentLogs.Count == 0)
        {
            <div class="portal-leaf">
                <p class="portal-register__meta mb-0">Nothing has been sent yet.</p>
            </div>
        }
        else
        {
            @foreach (var log in recentLogs)
            {
                <div class="portal-register__row">
                    <p class="portal-register__stamp">
                        <span class="portal-register__d">@log.SentAt.ToLocalTime().ToString("dd")</span>
                        <span class="portal-register__m">@log.SentAt.ToLocalTime().ToString("MMM")</span>
                    </p>

                    <div class="min-w-0">
                        <p class="portal-register__what">@log.Channel to @log.Recipient</p>
                        <p class="portal-register__meta">@log.MessageBody</p>
                        @if (!log.Success && !string.IsNullOrWhiteSpace(log.ErrorMessage))
                        {
                            <p class="portal-register__next text-danger">@log.ErrorMessage</p>
                        }
                    </div>

                    <p class="mb-0">
                        <span class="portal-mark @(log.Success ? "bg-success" : "bg-danger")">
                            @(log.Success ? "Sent" : "Failed")
                        </span>
                    </p>

                    <p class="portal-register__meta">@log.SentAt.ToLocalTime().ToString("h:mm tt")</p>
                </div>
            }
        }
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script nonce="@(Context.Items["CspNonce"])">
function availabilityManager() {
    const dayLabels = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];

    return {
        selectedDoctorId: '',
        saving: false,
        generating: false,
        generateFrom: '',
        generateTo: '',
        statusMsg: '',
        statusOk: true,
        schedule: dayLabels.map((label, i) => ({
            label,
            dayOfWeek: i,
            isActive: i >= 1 && i <= 5,   // Mon–Fri active by default
            startTime: '08:00',
            endTime: '16:00',
            slotDurationMinutes: 30
        })),

        async loadAvailability() {
            if (!this.selectedDoctorId) return;
            try {
                const res = await fetch(`/Admin/Availability/GetDoctorAvailability?doctorId=${this.selectedDoctorId}`);
                const data = await res.json();
                if (data.length > 0) {
                    this.schedule = dayLabels.map((label, i) => {
                        const found = data.find(d => d.dayOfWeek === i);
                        return {
                            label,
                            dayOfWeek: i,
                            isActive: found?.isActive ?? (i >= 1 && i <= 5),
                            startTime: found?.startTime ?? '08:00',
                            endTime: found?.endTime ?? '16:00',
                            slotDurationMinutes: found?.slotDurationMinutes ?? 30
                        };
                    });
                }
            } catch { this.showStatus('The hours for that doctor could not be loaded.', false); }
        },

        async saveAvailability() {
            this.saving = true;
            this.statusMsg = '';
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const res = await fetch('/Admin/Availability/SaveAvailability', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token || '' },
                    body: JSON.stringify({
                        doctorId: parseInt(this.selectedDoctorId),
                        days: this.schedule.map(d => ({
                            dayOfWeek: d.dayOfWeek,
                            startTime: d.startTime,
                            endTime: d.endTime,
                            slotDurationMinutes: parseInt(d.slotDurationMinutes),
                            isActive: d.isActive
                        }))
                    })
                });
                const data = await res.json();
                this.showStatus(data.message, data.success);
            } catch { this.showStatus('The week could not be saved. Please try again.', false); }
            finally { this.saving = false; }
        },

        async generateSlots() {
            if (!this.generateFrom || !this.generateTo) {
                this.showStatus('Choose the dates to generate slots between.', false);
                return;
            }
            this.generating = true;
            this.statusMsg = '';
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const res = await fetch('/Admin/Availability/GenerateSlots', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token || '' },
                    body: JSON.stringify({
                        doctorId: parseInt(this.selectedDoctorId),
                        fromDate: this.generateFrom,
                        toDate: this.generateTo
                    })
                });
                const data = await res.json();
                this.showStatus(data.message, data.success);
            } catch { this.showStatus('The slots could not be generated. Please try again.', false); }
            finally { this.generating = false; }
        },

        showStatus(msg, ok) {
            this.statusMsg = msg;
            this.statusOk = ok;
            setTimeout(() => { this.statusMsg = ''; }, 5000);
        }
    };
}
</script>
<script nonce="@(Context.Items["CspNonce"])" defer src="~/lib/alpinejs/dist/cdn.min.js" asp-append-version="true"></script>
}
