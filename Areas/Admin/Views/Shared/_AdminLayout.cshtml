@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject Okafor_.NET.Services.ILaunchFeatureAvailability LaunchFeatures

@{
    var currentPath = Context.Request.Path.Value ?? string.Empty;

    string ActiveClass(params string[] prefixes) =>
        prefixes.Any(prefix => currentPath.StartsWith(prefix, System.StringComparison.OrdinalIgnoreCase)) ? "active" : string.Empty;

    var dashboardActive = currentPath.Equals("/Admin", System.StringComparison.OrdinalIgnoreCase) ||
                          currentPath.StartsWith("/Admin/Dashboard", System.StringComparison.OrdinalIgnoreCase)
        ? "active"
        : string.Empty;

    // Most of this area is [Authorize(Roles = "Admin")]; only the booking,
    // teleconsultation, donation and payment queues also admit Staff. The rail
    // used to list every section to both, so a member of staff following most
    // of these links was refused by the page they arrived at.
    var isAdmin = User.IsInRole("Admin");
    var billPaymentsEnabled = LaunchFeatures.IsEnabled(Okafor_.NET.Services.LaunchFeature.BillPayments);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin</title>
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#072a3d" />
    <link rel="icon" href="~/images/icons/bapom-logo.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    @* portal.css sets the portal type stack; these are the faces it names.
       Atkinson Hyperlegible is drawn for low-vision legibility and carries all
       text and figures, Spectral carries headings, Source Sans 3 is the loaded
       fallback. The public site keeps Playfair and Inter. *@
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&family=Spectral:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Source+Sans+3:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
    <style>
        .portal-shell {
            min-height: 100vh;
        }

        .portal-main {
            flex: 1;
            min-width: 0;
        }

        /* Keep the navigation reachable on a long register instead of letting
           it scroll off the top. The rail itself still stretches the full page
           height so the navy column never stops short; only its contents pin. */
        @@media (min-width: 992px) {
            .portal-rail > .offcanvas-body {
                max-height: 100vh;
                overflow-y: auto;
                position: sticky;
                top: 0;
            }
        }

        @@media (max-width: 991.98px) {
            .portal-shell {
                display: block !important;
            }

            .portal-rail {
                min-height: 100%;
                width: min(88vw, 330px);
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<a class="visually-hidden-focusable btn btn-primary m-2" href="#portal-content">Skip to content</a>

<div class="portal-shell d-flex">
    <aside class="portal-rail offcanvas-lg offcanvas-start" tabindex="-1" id="adminSidebar" aria-labelledby="adminSidebarLabel">
        <div class="offcanvas-header d-lg-none">
            <div>
                <p class="portal-rail__name mb-0" id="adminSidebarLabel">Okafor Memorial</p>
                <p class="portal-rail__which">Hospital Office</p>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar" aria-label="Close"></button>
        </div>

        <div class="offcanvas-body p-3 d-flex flex-column">
            <div class="portal-rail__brand d-none d-lg-block px-2">
                <img src="~/images/icons/bapom-logo.png" alt="" class="portal-brand__mark mb-3" />
                <p class="portal-rail__name">Okafor Memorial</p>
                <p class="portal-rail__which">Hospital Office</p>
            </div>

            <nav class="nav flex-column" aria-label="Admin portal">
                <p class="portal-rail__group px-2">The day's work</p>
                @if (isAdmin)
                {
                    <a class="nav-link @dashboardActive" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <span>Home</span>
                    </a>
                }
                <a class="nav-link @ActiveClass("/Admin/AppointmentRequests")" asp-area="Admin" asp-controller="AppointmentRequests" asp-action="Index">
                    <span>Appointment requests</span>
                </a>
                <a class="nav-link @ActiveClass("/Admin/Teleconsultations")" asp-area="Admin" asp-controller="Teleconsultations" asp-action="Index">
                    <span>Teleconsultations</span>
                </a>
                @if (isAdmin)
                {
                    <a class="nav-link @ActiveClass("/Admin/ContactSubmissions")" asp-area="Admin" asp-controller="ContactSubmissions" asp-action="Index">
                        <span>Contact submissions</span>
                    </a>

                    <p class="portal-rail__group px-2">Patient records</p>
                    <a class="nav-link @ActiveClass("/Admin/PatientProfiles")" asp-area="Admin" asp-controller="PatientProfiles" asp-action="Index">
                        <span>Patient files</span>
                    </a>
                    <a class="nav-link @ActiveClass("/Admin/PatientAppointments")" asp-area="Admin" asp-controller="PatientAppointments" asp-action="Index">
                        <span>Booked appointments</span>
                    </a>
                    <a class="nav-link @ActiveClass("/Admin/PatientMessages")" asp-area="Admin" asp-controller="PatientMessages" asp-action="Index">
                        <span>Patient messages</span>
                    </a>

                    <p class="portal-rail__group px-2">The hospital</p>
                    <a class="nav-link @ActiveClass("/Doctors", "/Admin/Doctors")" asp-area="" asp-controller="Doctors" asp-action="Index">
                        <span>Doctors</span>
                    </a>
                    <a class="nav-link @ActiveClass("/Departments", "/Admin/Departments")" asp-area="" asp-controller="Departments" asp-action="Index">
                        <span>Departments</span>
                    </a>
                    <a class="nav-link @ActiveClass("/Admin/Availability")" asp-area="Admin" asp-controller="Availability" asp-action="Index">
                        <span>Consulting hours</span>
                    </a>
                    <a class="nav-link @ActiveClass("/Admin/Posts")" asp-area="Admin" asp-controller="Posts" asp-action="Index">
                        <span>News posts</span>
                    </a>
                }

                @* Donations are collected by CanadaHelps, off this site, so there
                   is no donations queue here any more. Without it this group can
                   be empty for a member of staff when bill payments are switched
                   off, so the heading is conditional too. *@
                @if (billPaymentsEnabled || isAdmin)
                {
                    <p class="portal-rail__group px-2">Money@(isAdmin ? " and accounts" : string.Empty)</p>
                }
                @if (billPaymentsEnabled)
                {
                    <a class="nav-link @ActiveClass("/Admin/BillPayments")" asp-area="Admin" asp-controller="BillPayments" asp-action="Index">
                        <span>Bill payments</span>
                    </a>
                }
                @if (isAdmin)
                {
                    <a class="nav-link @ActiveClass("/Admin/Users")" asp-area="Admin" asp-controller="Users" asp-action="Index">
                        <span>Staff accounts</span>
                    </a>
                    <a class="nav-link @ActiveClass("/Admin/Integrations")" asp-area="Admin" asp-controller="Integrations" asp-action="Index">
                        <span>Integration readiness</span>
                    </a>
                }

                <div class="portal-rail__hr mt-3"></div>
                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index" target="_blank" rel="noopener">
                    <span>The public site</span>
                </a>
            </nav>

            <div class="portal-rail__foot mt-auto">
                <p class="portal-rail__who text-truncate mb-2">@User.Identity?.Name</p>
                @if (SignInManager.IsSignedIn(User))
                {
                    <form asp-area="Identity" asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                        <button type="submit" class="btn btn-outline-secondary btn-sm w-100">Sign out</button>
                    </form>
                }
            </div>
        </div>
    </aside>

    <div class="portal-main">
        <header class="portal-crown">
            <div class="d-flex align-items-center gap-3 min-w-0">
                <button class="btn btn-outline-secondary btn-sm d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar" aria-label="Open admin navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <p class="portal-crown__where text-truncate">@ViewData["Title"]</p>
            </div>
            <p class="portal-crown__who d-none d-sm-block text-truncate">@User.Identity?.Name</p>
        </header>

        <main class="portal-sheet" id="portal-content">
            @* Every controller in the area reports its outcome through this one
               key, so no view prints an alert block of its own. UsersController
               wrote "SuccessMessage" instead and only Users/Index rendered it;
               both now go through here. *@
            @if (TempData["Success"] is string success)
            {
                <div class="portal-notice portal-notice--good alert-dismissible fade show mb-4" role="alert">
                    <p class="portal-notice__k">Done</p>
                    <p class="portal-notice__b">@success</p>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>
</div>

@* No portal script uses jQuery; Bootstrap 5 and Alpine are both free of it. The
   forms that want unobtrusive validation pull jQuery in with the validation
   partial instead of every portal page carrying it. *@
<script nonce="@(Context.Items["CspNonce"])" src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
<script nonce="@(Context.Items["CspNonce"])" src="~/lib/signalr/dist/browser/signalr.min.js" asp-append-version="true"></script>
<script nonce="@(Context.Items["CspNonce"])" src="~/js/booking-realtime.js" asp-append-version="true"></script>
<script nonce="@(Context.Items["CspNonce"])" src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
