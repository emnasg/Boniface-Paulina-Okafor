@model IEnumerable<Okafor_.NET.Models.PatientAppointment>

@{
    ViewData["Title"] = "Booked appointments";

    string MarkClass(PatientAppointmentStatus status) => status switch
    {
        PatientAppointmentStatus.Confirmed => "bg-success",
        PatientAppointmentStatus.Completed => "bg-secondary",
        PatientAppointmentStatus.Cancelled => "bg-danger",
        _ => "bg-warning"
    };

    var ahead = Model.Count(appointment => appointment.AppointmentDate > DateTime.Now);
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">The appointment book</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">Booked appointments</h1>
        <a asp-action="Create" class="btn btn-primary">Book an appointment</a>
    </div>
    <p class="portal-page-lede">
        Every appointment that appears in a patient's own portal, whether staff
        booked it here or approved it from a request.
    </p>
</div>

@if (!Model.Any())
{
    <div class="portal-empty">
        <div class="portal-fleuron"><span></span></div>
        <p class="portal-empty__h">Nothing is in the book</p>
        <p class="portal-empty__p">
            Approving an appointment request books it here automatically. You can
            also book one directly against a patient's file.
        </p>
        <a asp-action="Create" class="btn btn-primary">Book an appointment</a>
    </div>
}
else
{
    <div class="portal-register">
        <div class="portal-register__cap">
            <h2 class="portal-register__capt">Register of appointments</h2>
            <p class="portal-register__capn">
                @Model.Count() @(Model.Count() == 1 ? "record" : "records") &middot;
                @ahead still ahead
            </p>
        </div>

        @foreach (var appointment in Model)
        {
            <div class="portal-register__row">
                <p class="portal-register__stamp">
                    <span class="portal-register__d">@appointment.AppointmentDate.ToString("dd")</span>
                    <span class="portal-register__m">@appointment.AppointmentDate.ToString("MMM yyyy")</span>
                </p>

                <div class="min-w-0">
                    <p class="portal-register__what">@Or(appointment.PatientProfile?.FullName, "Unknown patient")</p>
                    <p class="portal-register__meta">
                        @appointment.AppointmentDate.ToString("h:mm tt") &middot;
                        @Or(appointment.Department?.Name, "No department") &middot;
                        @Or(appointment.Doctor?.FullName, "No doctor assigned")
                    </p>
                    @if (!string.IsNullOrWhiteSpace(appointment.Notes))
                    {
                        <p class="portal-register__sub">@appointment.Notes</p>
                    }
                </div>

                <p class="mb-0">
                    <span class="portal-mark @MarkClass(appointment.Status)">@appointment.Status</span>
                </p>

                <div class="portal-register__acts">
                    <a asp-area="Admin"
                       asp-controller="PatientProfiles"
                       asp-action="Details"
                       asp-route-id="@appointment.PatientProfileId"
                       class="portal-act">The file</a>
                    <a asp-action="Edit" asp-route-id="@appointment.Id" class="portal-act">Change</a>
                </div>
            </div>
        }
    </div>
}
