@model Okafor_.NET.Models.ContactSubmission

@{
    ViewData["Title"] = "Contact submission";

    var replySubject = Uri.EscapeDataString($"Re: {Model.Subject}");
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">Contact submission</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">@Model.Subject</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to the submissions</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-7">
        <div class="portal-docket">
            <div class="portal-docket__cap">
                <p class="portal-docket__label">
                    Sent @Model.SubmittedAt.ToLocalTime().ToString("dddd, d MMMM yyyy 'at' h:mm tt")
                </p>
            </div>

            <p class="portal-prose portal-docket__ledger">@Model.Message</p>
        </div>
    </div>

    <aside class="col-12 col-lg-5">
        <h2 class="portal-register__capt mb-3">Who sent it</h2>

        <dl class="portal-leaders mb-4">
            <div class="portal-lead">
                <dt class="portal-lead__k">Name</dt>
                <dd class="portal-lead__fill"></dd>
                <dd class="portal-lead__v">@Model.Name</dd>
            </div>
            <div class="portal-lead">
                <dt class="portal-lead__k">Email</dt>
                <dd class="portal-lead__fill"></dd>
                <dd class="portal-lead__v">@Model.Email</dd>
            </div>
        </dl>

        <div class="d-grid gap-2">
            <a href="mailto:@Model.Email?subject=@replySubject" class="btn btn-primary">Reply by email</a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                  onsubmit="return confirm('Delete this submission? It cannot be recovered.');">
                <button type="submit" class="btn btn-outline-danger w-100">Delete this submission</button>
            </form>
        </div>
    </aside>
</div>
