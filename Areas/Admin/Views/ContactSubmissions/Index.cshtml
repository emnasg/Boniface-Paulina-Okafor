@model IEnumerable<Okafor_.NET.Models.ContactSubmission>

@{
    ViewData["Title"] = "Contact submissions";
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">The day's work</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">Contact submissions</h1>
    </div>
    <p class="portal-page-lede">
        Sent through the contact form on the public site, by people who may have
        no account and no file here.
    </p>
</div>

@if (!Model.Any())
{
    <div class="portal-empty">
        <div class="portal-fleuron"><span></span></div>
        <p class="portal-empty__h">Nothing has been sent in</p>
        <p class="portal-empty__p">
            Messages from the contact form on the public site arrive here with the
            sender's name and email address.
        </p>
    </div>
}
else
{
    <div class="portal-register portal-register--brief">
        <div class="portal-register__cap">
            <h2 class="portal-register__capt">Register of submissions</h2>
            <p class="portal-register__capn">
                @Model.Count() @(Model.Count() == 1 ? "submission" : "submissions") &middot; newest first
            </p>
        </div>

        @foreach (var submission in Model)
        {
            <div class="portal-register__row">
                <p class="portal-register__stamp">
                    <span class="portal-register__d">@submission.SubmittedAt.ToLocalTime().ToString("dd")</span>
                    <span class="portal-register__m">@submission.SubmittedAt.ToLocalTime().ToString("MMM yyyy")</span>
                </p>

                <div class="min-w-0">
                    <p class="portal-register__what">@submission.Subject</p>
                    <p class="portal-register__meta">
                        @submission.Name &middot; @submission.SubmittedAt.ToLocalTime().ToString("h:mm tt")
                    </p>
                    <p class="portal-register__sub">@submission.Email</p>
                </div>

                <div class="portal-register__acts">
                    <a asp-action="Details" asp-route-id="@submission.Id" class="portal-act">Read it</a>
                </div>
            </div>
        }
    </div>
}
