@model IEnumerable<Okafor_.NET.Models.TeleconsultationRequest>

@{
    ViewData["Title"] = "Teleconsultations";

    // The class names booking-realtime.js writes on a live status change, which
    // is also what portal.css styles .portal-mark from.
    string MarkClass(TeleconsultationStatus status) => status switch
    {
        TeleconsultationStatus.Confirmed => "bg-success",
        TeleconsultationStatus.Completed => "bg-secondary",
        TeleconsultationStatus.Rejected or TeleconsultationStatus.Cancelled => "bg-danger",
        TeleconsultationStatus.Rescheduled => "bg-info",
        _ => "bg-warning"
    };

    var pending = Model.Count(request => request.Status == TeleconsultationStatus.Pending);
    var filtered = !string.IsNullOrWhiteSpace(Context.Request.Query["status"]);
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">The consulting queue</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">Teleconsultations</h1>
    </div>
</div>

<div class="alert d-none" data-booking-realtime role="status" aria-live="polite"></div>

<form method="get" class="portal-filter">
    <p class="portal-filter__k">Narrow the register</p>
    <div class="portal-filter__row">
        <div>
            <label for="teleconsultation-status" class="form-label">Status</label>
            <select id="teleconsultation-status" name="status" class="form-select" asp-items="ViewBag.Status">
                <option value="">Every standing</option>
            </select>
        </div>
    </div>
    <div class="portal-filter__acts">
        <button class="btn btn-primary" type="submit">Filter</button>
        @if (filtered)
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="portal-empty">
        <div class="portal-fleuron"><span></span></div>
        <p class="portal-empty__h">@(filtered ? "Nothing matches that filter" : "No teleconsultations have been requested")</p>
        <p class="portal-empty__p">
            @if (filtered)
            {
                <text>Clearing the filter shows every request the hospital has received.</text>
            }
            else
            {
                <text>
                    Requests made through the teleconsultation form on the public site
                    arrive here with the date, the department and the kind of consultation asked for.
                </text>
            }
        </p>
        @if (filtered)
        {
            <a asp-action="Index" class="btn btn-primary">Show every request</a>
        }
    </div>
}
else
{
    <div class="portal-register">
        <div class="portal-register__cap">
            <h2 class="portal-register__capt">Register of teleconsultations</h2>
            <p class="portal-register__capn">
                <span data-booking-pending-count="teleconsultation">@pending</span> awaiting a decision &middot;
                @Model.Count() @(Model.Count() == 1 ? "record" : "records") shown
            </p>
        </div>

        @foreach (var request in Model)
        {
            <div class="portal-register__row" data-booking-row="teleconsultation:@request.Id">
                <p class="portal-register__stamp">
                    <span class="portal-register__d">@request.PreferredDate.ToString("dd")</span>
                    <span class="portal-register__m">@request.PreferredDate.ToString("MMM yyyy")</span>
                </p>

                <div class="min-w-0">
                    <p class="portal-register__what">@request.PatientName</p>
                    <p class="portal-register__meta">
                        @Or(request.Department?.Name, "No department given")
                        @if (!string.IsNullOrWhiteSpace(request.PreferredTime))
                        {
                            <text> &middot; asked for @request.PreferredTime</text>
                        }
                        &middot; @request.ConsultationType
                    </p>
                    <p class="portal-register__sub">@FirstOr(request.Email, request.Phone, "No contact details given")</p>
                    @if (string.IsNullOrWhiteSpace(request.MeetingLink) &&
                         request.Status is TeleconsultationStatus.Confirmed or TeleconsultationStatus.Rescheduled)
                    {
                        <p class="portal-register__next">No meeting link has been sent to this patient yet.</p>
                    }
                </div>

                <p class="mb-0">
                    <span class="portal-mark @MarkClass(request.Status)" data-booking-status="teleconsultation:@request.Id">@request.Status</span>
                </p>

                <div class="portal-register__acts">
                    <a asp-action="Details" asp-route-id="@request.Id" class="portal-act">Read</a>
                    <a asp-action="Edit" asp-route-id="@request.Id" class="portal-act">Update</a>
                </div>
            </div>
        }
    </div>
}
