@model Okafor_.NET.ViewModels.AdminTeleconsultationDetailsViewModel

@{
    ViewData["Title"] = "Teleconsultation";

    var request = Model.Request;

    string MarkClass(TeleconsultationStatus status) => status switch
    {
        TeleconsultationStatus.Confirmed => "bg-success",
        TeleconsultationStatus.Completed => "bg-secondary",
        TeleconsultationStatus.Rejected or TeleconsultationStatus.Cancelled => "bg-danger",
        TeleconsultationStatus.Rescheduled => "bg-info",
        _ => "bg-warning"
    };
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">Teleconsultation</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">@request.PatientName</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to the queue</a>
    </div>
</div>

<div class="portal-docket portal-measure">
    <div class="portal-docket__cap">
        <p class="portal-docket__ref">TC-@request.Id.ToString("D6")</p>
        <span class="portal-mark @MarkClass(request.Status)" data-booking-status="teleconsultation:@request.Id">@request.Status</span>
    </div>

    <dl class="portal-leaders portal-docket__ledger">
        <div class="portal-lead">
            <dt class="portal-lead__k">Email</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Or(request.Email, "Not given")</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Telephone</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Or(request.Phone, "Not given")</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">WhatsApp updates</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@(request.WhatsAppOptIn ? "Opted in" : "Not opted in")</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Department</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Or(request.Department?.Name, "Not given")</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Doctor</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Or(request.Doctor?.FullName, "No preference given")</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Date asked for</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">
                @request.PreferredDate.ToString("d MMMM yyyy")
                @if (!string.IsNullOrWhiteSpace(request.PreferredTime))
                {
                    <text>, @request.PreferredTime</text>
                }
            </dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Kind</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@request.ConsultationType</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Meeting link</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Or(request.MeetingLink, "Not sent yet")</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Linked account</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Or(request.ApplicationUser?.Email, "Requested without an account")</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Patient file</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Or(request.PatientProfile?.FullName, "Not linked")</dd>
        </div>
    </dl>

    @if (!string.IsNullOrWhiteSpace(request.Reason))
    {
        <p class="portal-plate__prep">@request.Reason</p>
    }

    <div class="portal-docket__acts">
        <a asp-action="Edit" asp-route-id="@request.Id" class="btn btn-primary">Update this request</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(request.AdminNotes))
{
    <div class="portal-register portal-measure mt-4">
        <div class="portal-register__cap">
            <h2 class="portal-register__capt">Staff notes</h2>
        </div>
        <div class="portal-leaf">
            <p class="portal-prose">@request.AdminNotes</p>
        </div>
    </div>
}

<div class="portal-register mt-4">
    <div class="portal-register__cap">
        <h2 class="portal-register__capt">What we have sent this patient</h2>
        <p class="portal-register__capn">
            @Model.Notifications.Count @(Model.Notifications.Count == 1 ? "message" : "messages") logged
        </p>
    </div>

    @if (!Model.Notifications.Any())
    {
        <div class="portal-leaf">
            <p class="portal-register__meta mb-0">
                Nothing has been sent yet. Confirming or rescheduling this request
                sends the patient a message and records it here.
            </p>
        </div>
    }
    else
    {
        @foreach (var notification in Model.Notifications)
        {
            <div class="portal-register__row">
                <p class="portal-register__stamp">
                    <span class="portal-register__d">@notification.SentAt.ToLocalTime().ToString("dd")</span>
                    <span class="portal-register__m">@notification.SentAt.ToLocalTime().ToString("MMM")</span>
                </p>

                <div class="min-w-0">
                    <p class="portal-register__what">@notification.Channel to @notification.Recipient</p>
                    <p class="portal-register__meta">@notification.Message</p>
                    @if (notification.DeliveredAt.HasValue)
                    {
                        <p class="portal-register__sub">Delivered @notification.DeliveredAt.Value.ToLocalTime().ToString("h:mm tt")</p>
                    }
                    @if (notification.ReadAt.HasValue)
                    {
                        <p class="portal-register__sub">Read @notification.ReadAt.Value.ToLocalTime().ToString("h:mm tt")</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(notification.ErrorMessage))
                    {
                        <p class="portal-register__next text-danger">@notification.ErrorMessage</p>
                    }
                </div>

                <p class="mb-0">
                    <span class="portal-mark @(notification.Success ? "bg-success" : "bg-danger")">
                        @(notification.DeliveryStatus ?? (notification.Success ? "Sent" : "Failed"))
                    </span>
                </p>

                <p class="portal-register__meta">@notification.SentAt.ToLocalTime().ToString("h:mm tt")</p>
            </div>
        }
    }
</div>
