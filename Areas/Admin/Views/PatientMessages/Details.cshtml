@model Okafor_.NET.Models.PatientMessage

@{
    ViewData["Title"] = "Patient message";

    var email = Model.PatientProfile?.ApplicationUser?.Email;
    var phone = Model.PatientProfile?.Phone ?? Model.PatientProfile?.ApplicationUser?.PhoneNumber;
    var replySubject = Uri.EscapeDataString($"Re: {Model.Subject}");
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">Patient message</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">@Model.Subject</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to the messages</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-7">
        <div class="portal-docket">
            <div class="portal-docket__cap">
                <p class="portal-docket__label">
                    Sent @Model.SentAt.ToLocalTime().ToString("dddd, d MMMM yyyy 'at' h:mm tt")
                </p>
                <span class="portal-mark @(Model.IsRead ? "bg-success" : "bg-warning")">
                    @(Model.IsRead ? "Reviewed" : "Awaiting review")
                </span>
            </div>

            <p class="portal-prose portal-docket__ledger">@Model.Body</p>
        </div>
    </div>

    <aside class="col-12 col-lg-5">
        <h2 class="portal-register__capt mb-3">Reaching this patient</h2>

        <dl class="portal-leaders mb-4">
            <div class="portal-lead">
                <dt class="portal-lead__k">Name</dt>
                <dd class="portal-lead__fill"></dd>
                <dd class="portal-lead__v">@Or(Model.PatientProfile?.FullName, "Unknown patient")</dd>
            </div>
            <div class="portal-lead">
                <dt class="portal-lead__k">Email</dt>
                <dd class="portal-lead__fill"></dd>
                <dd class="portal-lead__v">@Or(email, "Not on file")</dd>
            </div>
            <div class="portal-lead">
                <dt class="portal-lead__k">Telephone</dt>
                <dd class="portal-lead__fill"></dd>
                <dd class="portal-lead__v">@Or(phone, "Not on file")</dd>
            </div>
        </dl>

        <div class="d-grid gap-2">
            @if (!string.IsNullOrWhiteSpace(email))
            {
                <a href="mailto:@email?subject=@replySubject" class="btn btn-primary">Reply by email</a>
            }
            @if (!string.IsNullOrWhiteSpace(phone))
            {
                <a href="tel:@phone" class="btn btn-outline-secondary">Ring the patient</a>
            }
            @if (!Model.IsRead)
            {
                <form asp-action="MarkReviewed" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-outline-success w-100">Mark as reviewed</button>
                </form>
            }
        </div>

        @if (Model.PatientProfileId > 0)
        {
            <p class="portal-register__meta mt-3">
                <a asp-area="Admin" asp-controller="PatientProfiles" asp-action="Details"
                   asp-route-id="@Model.PatientProfileId" class="portal-act">Open their file</a>
            </p>
        }
    </aside>
</div>
