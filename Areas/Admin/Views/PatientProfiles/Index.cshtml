@model IEnumerable<Okafor_.NET.Models.PatientProfile>

@{
    ViewData["Title"] = "Patient files";
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">Patient records</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">Patient files</h1>
        <a asp-action="Create" class="btn btn-primary">Open a new file</a>
    </div>
    <p class="portal-page-lede">
        A file links a person to their account, and holds the appointments,
        messages and documents that account can see.
    </p>
</div>

@if (!Model.Any())
{
    <div class="portal-empty">
        <div class="portal-fleuron"><span></span></div>
        <p class="portal-empty__h">No files have been opened</p>
        <p class="portal-empty__p">
            Patients can open their own file from their portal. You can also open
            one here and link it to an existing account.
        </p>
        <a asp-action="Create" class="btn btn-primary">Open a new file</a>
    </div>
}
else
{
    <div class="portal-register portal-register--titled">
        <div class="portal-register__cap">
            <h2 class="portal-register__capt">Register of patients</h2>
            <p class="portal-register__capn">
                @Model.Count() @(Model.Count() == 1 ? "file" : "files") &middot; by name
            </p>
        </div>

        @foreach (var profile in Model)
        {
            <div class="portal-register__row">
                <div class="min-w-0">
                    <p class="portal-register__what">@profile.FullName</p>
                    <p class="portal-register__meta">
                        @Or(profile.Phone, "No telephone number on file") &middot;
                        opened @profile.CreatedAt.ToLocalTime().ToString("d MMM yyyy")
                    </p>
                    <p class="portal-register__sub">@Or(profile.ApplicationUser?.Email, "Not linked to an account")</p>
                </div>

                <p class="portal-register__meta mb-0">
                    @profile.Documents.Count @(profile.Documents.Count == 1 ? "document" : "documents")
                </p>

                <div class="portal-register__acts">
                    <a asp-action="Details" asp-route-id="@profile.Id" class="portal-act">Open the file</a>
                </div>
            </div>
        }
    </div>
}
