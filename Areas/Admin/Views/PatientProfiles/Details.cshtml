@model Okafor_.NET.Models.PatientProfile
@inject Okafor_.NET.Services.ILaunchFeatureAvailability LaunchFeatures

@{
    ViewData["Title"] = Model.FullName;

    var documentsEnabled = LaunchFeatures.IsEnabled(Okafor_.NET.Services.LaunchFeature.PatientDocuments);
    var documents = Model.Documents.OrderByDescending(document => document.UploadedAt).ToList();
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">Patient file</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">@Model.FullName</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to the files</a>
    </div>
</div>

<div class="portal-docket portal-measure">
    <div class="portal-docket__cap">
        <p class="portal-docket__ref">PF-@Model.Id.ToString("D6")</p>
        <p class="portal-docket__label">Opened @Model.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</p>
    </div>

    <dl class="portal-leaders portal-docket__ledger">
        <div class="portal-lead">
            <dt class="portal-lead__k">Account</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Or(Model.ApplicationUser?.Email, "Not linked")</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Telephone</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Or(Model.Phone, "Not given")</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Address</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Or(Model.Address, "Not given")</dd>
        </div>
    </dl>

    <div class="portal-docket__acts">
        <a asp-area="Admin" asp-controller="PatientAppointments" asp-action="Create" class="btn btn-primary">Book an appointment</a>
        @if (documentsEnabled)
        {
            <a asp-action="UploadDocument" asp-route-patientId="@Model.Id" class="btn btn-outline-secondary">File a document</a>
        }
    </div>
</div>

@if (documentsEnabled)
{
    <div class="portal-register portal-register--titled portal-register--brief mt-4">
        <div class="portal-register__cap">
            <h2 class="portal-register__capt">Documents on file</h2>
            <p class="portal-register__capn">
                @documents.Count @(documents.Count == 1 ? "document" : "documents") &middot; the patient can read these in their portal
            </p>
        </div>

        @if (documents.Count == 0)
        {
            <div class="portal-leaf">
                <p class="portal-register__meta mb-0">
                    Nothing has been filed yet. Results, letters and discharge notes
                    filed here appear in the patient's own portal.
                </p>
            </div>
        }
        else
        {
            @foreach (var document in documents)
            {
                <div class="portal-register__row">
                    <div class="min-w-0">
                        <p class="portal-register__what">@document.Title</p>
                        @if (!string.IsNullOrWhiteSpace(document.Description))
                        {
                            <p class="portal-register__meta">@document.Description</p>
                        }
                        <p class="portal-register__sub">Filed @document.UploadedAt.ToLocalTime().ToString("d MMM yyyy, h:mm tt")</p>
                    </div>

                    <div class="portal-register__acts">
                        <a asp-action="DownloadDocument"
                           asp-route-documentId="@document.Id"
                           asp-route-patientId="@Model.Id"
                           target="_blank"
                           rel="noopener"
                           class="portal-act">Download</a>
                        <form asp-action="DeleteDocument" method="post" class="portal-act-form portal-act-form--grave"
                              onsubmit="return confirm('Delete &quot;@document.Title&quot;? The patient loses access to it and it cannot be recovered.');">
                            <input type="hidden" name="documentId" value="@document.Id" />
                            <input type="hidden" name="patientId" value="@Model.Id" />
                            <button type="submit">Delete</button>
                        </form>
                    </div>
                </div>
            }
        }
    </div>
}
