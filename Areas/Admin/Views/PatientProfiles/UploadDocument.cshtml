@model Okafor_.NET.ViewModels.AdminUploadDocumentViewModel

@{
    ViewData["Title"] = "File a document";
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">Patient file &mdash; @ViewBag.PatientName</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">File a document</h1>
        <a asp-action="Details" asp-route-id="@Model.PatientProfileId" class="btn btn-outline-secondary">Back to the file</a>
    </div>
    <p class="portal-page-lede">
        What you file here is readable by @ViewBag.PatientName in their own
        portal as soon as it is uploaded. Check it belongs to this patient before
        you do.
    </p>
</div>

<form asp-area="Admin" asp-controller="PatientProfiles" asp-action="UploadDocument"
      method="post" enctype="multipart/form-data" class="portal-form">
    <input type="hidden" asp-for="PatientProfileId" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label">Title</label>
        <input asp-for="Title" class="form-control" placeholder="Example: blood test results, April 2026" />
        <div class="form-text">What the patient will see in the list of their documents.</div>
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">Description</label>
        <textarea asp-for="Description" rows="2" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label asp-for="File" class="form-label">The file</label>
        <input asp-for="File" type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.webp" />
        <div class="form-text">A PDF or an image &mdash; JPG, JPEG, PNG or WebP &mdash; up to 10 MB.</div>
        <span asp-validation-for="File" class="text-danger"></span>
    </div>

    <div class="d-grid d-sm-flex gap-2">
        <button type="submit" class="btn btn-primary">File it</button>
        <a asp-action="Details" asp-route-id="@Model.PatientProfileId" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
