@model Okafor_.NET.ViewModels.EditRolesViewModel

@{
    ViewData["Title"] = "Change roles";
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">Staff accounts</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">@Model.Email</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to the accounts</a>
    </div>
    <p class="portal-page-lede">
        Roles take effect the next time this person signs in. Removing both
        leaves them able to sign in as a patient, but not to reach this portal.
    </p>
</div>

<form asp-action="EditRoles" method="post" class="portal-form">
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Email" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

    <div class="form-check mb-4">
        <input asp-for="IsAdmin" class="form-check-input" id="isAdmin" />
        <label class="form-check-label" for="isAdmin"><strong>Admin</strong></label>
        <div class="form-text">
            Everything in this portal: patient files and messages, doctors,
            departments, consulting hours, news posts and accounts.
        </div>
    </div>

    <div class="form-check mb-4">
        <input asp-for="IsStaff" class="form-check-input" id="isStaff" />
        <label class="form-check-label" for="isStaff"><strong>Staff</strong></label>
        <div class="form-text">
            The booking, teleconsultation, payment and donation queues only. No
            access to patient files.
        </div>
    </div>

    <div class="d-grid d-sm-flex gap-2">
        <button type="submit" class="btn btn-primary">Save these roles</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
