@model Okafor_.NET.Models.BillPayment

@{
    ViewData["Title"] = "Bill payment";

    string MarkClass(BillPaymentStatus status) => status switch
    {
        BillPaymentStatus.Paid => "bg-success",
        BillPaymentStatus.SandboxApproved => "bg-info",
        BillPaymentStatus.Pending => "bg-warning",
        BillPaymentStatus.Failed => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">Bill payment</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">@Model.InvoiceNumber</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to the payments</a>
    </div>
</div>

<div class="portal-docket portal-measure">
    <div class="portal-docket__cap">
        <p class="portal-docket__ref">@Model.Currency @Model.Amount.ToString("N2")</p>
        <span class="portal-mark @MarkClass(Model.Status)">@Model.Status</span>
    </div>

    <dl class="portal-leaders portal-docket__ledger">
        <div class="portal-lead">
            <dt class="portal-lead__k">Patient</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Model.PatientName</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Email</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">
                @if (string.IsNullOrWhiteSpace(Model.PatientEmail))
                {
                    <text>Not given</text>
                }
                else
                {
                    <a href="mailto:@Model.PatientEmail">@Model.PatientEmail</a>
                }
            </dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Telephone</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">
                @if (string.IsNullOrWhiteSpace(Model.PatientPhone))
                {
                    <text>Not given</text>
                }
                else
                {
                    <a href="tel:@Model.PatientPhone">@Model.PatientPhone</a>
                }
            </dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Provider</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Model.Provider &middot; @(Model.IsSandbox ? "sandbox" : "production")</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Provider reference</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Or(Model.ProviderReference, "None recorded")</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Channel</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Or(Model.Channel, "None recorded")</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Provider message</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Or(Model.ProviderMessage, "None recorded")</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Linked account</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Or(Model.ApplicationUser?.Email, "Paid without an account")</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Started</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Model.CreatedAt.ToLocalTime().ToString("d MMM yyyy, h:mm tt")</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Settled</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@(Model.PaidAt?.ToLocalTime().ToString("d MMM yyyy, h:mm tt") ?? "Not confirmed")</dd>
        </div>
    </dl>
</div>
