@model IEnumerable<Okafor_.NET.Models.BillPayment>

@{
    ViewData["Title"] = "Bill payments";

    string MarkClass(BillPaymentStatus status) => status switch
    {
        BillPaymentStatus.Paid => "bg-success",
        BillPaymentStatus.SandboxApproved => "bg-info",
        BillPaymentStatus.Pending => "bg-warning",
        BillPaymentStatus.Failed => "bg-danger",
        _ => "bg-secondary"
    };

    var query = Context.Request.Query;
    var filtered = !string.IsNullOrWhiteSpace(query["query"]) || !string.IsNullOrWhiteSpace(query["status"]);
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">Money and accounts</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">Bill payments</h1>
    </div>
</div>

<form method="get" class="portal-filter">
    <p class="portal-filter__k">Narrow the register</p>
    <div class="portal-filter__row">
        <div>
            <label for="payment-search" class="form-label">Search</label>
            <input id="payment-search" name="query" value="@ViewData["Query"]" class="form-control"
                   placeholder="Invoice, patient or email" />
        </div>
        <div>
            <label for="payment-status" class="form-label">Status</label>
            <select id="payment-status" name="status" class="form-select" asp-items="ViewBag.Status">
                <option value="">Every standing</option>
            </select>
        </div>
    </div>
    <div class="portal-filter__acts">
        <button class="btn btn-primary" type="submit">Filter</button>
        @if (filtered)
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="portal-empty">
        <div class="portal-fleuron"><span></span></div>
        <p class="portal-empty__h">@(filtered ? "Nothing matches that search" : "No payments have been recorded")</p>
        <p class="portal-empty__p">
            @if (filtered)
            {
                <text>Clearing the search shows every payment the hospital has recorded.</text>
            }
            else
            {
                <text>Bills settled through the payment page on the public site are recorded here.</text>
            }
        </p>
        @if (filtered)
        {
            <a asp-action="Index" class="btn btn-primary">Show every payment</a>
        }
    </div>
}
else
{
    <div class="portal-register">
        <div class="portal-register__cap">
            <h2 class="portal-register__capt">Register of payments</h2>
            <p class="portal-register__capn">
                @Model.Count() @(Model.Count() == 1 ? "record" : "records") shown &middot; newest first
            </p>
        </div>

        @foreach (var payment in Model)
        {
            <div class="portal-register__row">
                <p class="portal-register__stamp">
                    <span class="portal-register__d">@payment.CreatedAt.ToLocalTime().ToString("dd")</span>
                    <span class="portal-register__m">@payment.CreatedAt.ToLocalTime().ToString("MMM yyyy")</span>
                </p>

                <div class="min-w-0">
                    <p class="portal-register__what">@payment.InvoiceNumber</p>
                    <p class="portal-register__meta">
                        @payment.PatientName &middot; @(payment.IsSandbox ? "sandbox" : "production")
                    </p>
                    <p class="portal-register__sub">
                        @Or(payment.PatientEmail, "No email given")
                        @if (!string.IsNullOrWhiteSpace(payment.ProviderReference))
                        {
                            <text> &middot; @payment.ProviderReference</text>
                        }
                    </p>
                </div>

                <div>
                    <p class="portal-register__sum">@payment.Currency @payment.Amount.ToString("N2")</p>
                    <span class="portal-mark @MarkClass(payment.Status)">@payment.Status</span>
                </div>

                <div class="portal-register__acts">
                    <a asp-action="Details" asp-route-id="@payment.Id" class="portal-act">Open</a>
                </div>
            </div>
        }
    </div>
}
