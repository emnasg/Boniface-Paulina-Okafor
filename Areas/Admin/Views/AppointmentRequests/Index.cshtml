@model IEnumerable<Okafor_.NET.Models.AppointmentRequest>

@{
    ViewData["Title"] = "Appointment requests";

    // booking-realtime.js rewrites these same class names when a request is
    // actioned in another browser, and portal.css styles .portal-mark from them,
    // so a live update recolours the mark with no change to that script.
    string MarkClass(AppointmentStatus status) => status switch
    {
        AppointmentStatus.Approved => "bg-success",
        AppointmentStatus.Rejected => "bg-danger",
        AppointmentStatus.Cancelled => "bg-secondary",
        _ => "bg-warning"
    };

    var pending = Model.Count(request => request.Status == AppointmentStatus.Pending);
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">The booking queue</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">Appointment requests</h1>
    </div>
</div>

<div class="alert d-none" data-booking-realtime data-booking-autoreload role="status" aria-live="polite"></div>

@if (!Model.Any())
{
    <div class="portal-empty">
        <div class="portal-fleuron"><span></span></div>
        <p class="portal-empty__h">No requests have come in</p>
        <p class="portal-empty__p">
            Requests submitted through the booking form on the public site arrive
            here, newest first, with the date and department the patient asked for.
        </p>
        <a asp-area="" asp-controller="AppointmentRequests" asp-action="Create" class="btn btn-outline-secondary">See the public booking form</a>
    </div>
}
else
{
    <div class="portal-register">
        <div class="portal-register__cap">
            <h2 class="portal-register__capt">Register of requests</h2>
            <p class="portal-register__capn">
                <span data-booking-pending-count="appointment">@pending</span> awaiting a decision &middot;
                @Model.Count() @(Model.Count() == 1 ? "record" : "records") in all
            </p>
        </div>

        @foreach (var request in Model)
        {
            <div class="portal-register__row" data-booking-row="appointment:@request.Id">
                <p class="portal-register__stamp">
                    <span class="portal-register__d">@request.PreferredDate.ToString("dd")</span>
                    <span class="portal-register__m">@request.PreferredDate.ToString("MMM yyyy")</span>
                </p>

                <div class="min-w-0">
                    <p class="portal-register__what">@request.PatientName</p>
                    <p class="portal-register__meta">
                        @Or(request.Department?.Name, "No department given")
                        @if (!string.IsNullOrWhiteSpace(request.PreferredTime))
                        {
                            <text> &middot; asked for @request.PreferredTime</text>
                        }
                        &middot; @Or(request.Doctor?.FullName, "No doctor assigned")
                    </p>
                    <p class="portal-register__sub">
                        @FirstOr(request.Email, request.Phone, "No contact details given")
                        @if (request.ContactConfirmed)
                        {
                            <text> &middot; confirmed by @request.ContactMethod</text>
                        }
                        else
                        {
                            <text> &middot; not yet contacted</text>
                        }
                    </p>
                    <p class="portal-register__next">Received @request.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</p>
                </div>

                <p class="mb-0">
                    <span class="portal-mark @MarkClass(request.Status)" data-booking-status="appointment:@request.Id">@request.Status</span>
                </p>

                <div class="portal-register__acts">
                    <a asp-action="Details" asp-route-id="@request.Id" class="portal-act">Read</a>
                    <a asp-action="Edit" asp-route-id="@request.Id" class="portal-act">Decide</a>
                </div>
            </div>
        }
    </div>
}
