@model Okafor_.NET.ViewModels.AdminAppointmentRequestUpdateViewModel

@{
    ViewData["Title"] = "Decide a request";
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">Appointment request</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">@Model.PatientName</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to the queue</a>
    </div>
</div>

@* What the patient asked for is not editable here, so it is set as a record to
   read rather than as a column of greyed-out text boxes. *@
<div class="portal-docket portal-measure mb-4">
    <div class="portal-docket__cap">
        <p class="portal-docket__ref">AR-@Model.Id.ToString("D6")</p>
        <p class="portal-docket__label">Received @Model.CreatedAt.ToLocalTime().ToString("d MMM yyyy, h:mm tt")</p>
    </div>

    <dl class="portal-leaders portal-docket__ledger">
        <div class="portal-lead">
            <dt class="portal-lead__k">Email</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Or(Model.Email, "Not given")</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Telephone</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Or(Model.Phone, "Not given")</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Department</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Model.DepartmentName</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Date asked for</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">
                @Model.PreferredDate.ToString("d MMMM yyyy")
                @if (!string.IsNullOrWhiteSpace(Model.PreferredTime))
                {
                    <text>, @Model.PreferredTime</text>
                }
            </dd>
        </div>
    </dl>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <p class="portal-plate__prep">@Model.Message</p>
    }
</div>

<div class="portal-notice portal-notice--info mb-4">
    <p class="portal-notice__k">Approving reserves the slot</p>
    <p class="portal-notice__b">
        The doctor and time are checked for a clash first. If there is one,
        assign a different doctor or reschedule before approving. Approving also
        creates a confirmed appointment in the patient's portal, if their account
        has a profile.
    </p>
</div>

<form asp-action="Edit" method="post" class="portal-form">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="DoctorId" class="form-label">Assign a doctor</label>
        <select asp-for="DoctorId" class="form-select" asp-items="ViewBag.DoctorId">
            <option value="">Leave unassigned</option>
        </select>
        <span asp-validation-for="DoctorId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label">Decision</label>
        <select asp-for="Status" class="form-select" asp-items="ViewBag.Status"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <fieldset class="mb-4">
        <legend class="portal-legend">Contact with the patient</legend>

        <div class="form-check mb-3">
            <input asp-for="ContactConfirmed" class="form-check-input" />
            <label asp-for="ContactConfirmed" class="form-check-label">I have confirmed these details with the patient</label>
        </div>

        <div class="mb-3">
            <label asp-for="ContactMethod" class="form-label">How they were contacted</label>
            <select asp-for="ContactMethod" class="form-select">
                <option value="">Not yet contacted</option>
                <option value="Call">Telephone call</option>
                <option value="Email">Email</option>
            </select>
            <span asp-validation-for="ContactMethod" class="text-danger"></span>
        </div>

        <div class="mb-0">
            <label asp-for="ContactNotes" class="form-label">Notes on that contact</label>
            <textarea asp-for="ContactNotes" class="form-control" rows="3"
                      placeholder="Example: called the patient, confirmed the date and their telephone number."></textarea>
            <span asp-validation-for="ContactNotes" class="text-danger"></span>
        </div>
    </fieldset>

    <div class="d-grid d-sm-flex gap-2">
        <button type="submit" class="btn btn-primary">Save this decision</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
