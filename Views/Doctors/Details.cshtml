@model Okafor_.NET.Models.Doctor

@{
    ViewData["Title"] = Model.FullName;
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">Doctor</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">@Model.FullName</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to the doctors</a>
    </div>
</div>

<div class="portal-docket portal-measure">
    <div class="portal-docket__cap">
        <p class="portal-docket__ref">@Model.Specialty</p>
        <span class="portal-mark @(Model.IsFeatured ? "bg-warning" : "bg-secondary")">
            @(Model.IsFeatured ? "On the homepage" : "Listed only")
        </span>
    </div>

    <dl class="portal-leaders portal-docket__ledger">
        <div class="portal-lead">
            <dt class="portal-lead__k">Department</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Or(Model.Department?.Name, "Not assigned")</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Consulting hours</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Or(Model.ConsultationHours, "Not given")</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Qualifications</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Or(Model.Qualifications, "Not given")</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">Page on the site</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@(string.IsNullOrWhiteSpace(Model.Slug) ? "No address set" : $"/doctors/{Model.Slug}")</dd>
        </div>
    </dl>

    @if (!string.IsNullOrWhiteSpace(Model.Bio))
    {
        <p class="portal-plate__prep">@Model.Bio</p>
    }

    <div class="portal-docket__acts">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit this doctor</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Remove</a>
    </div>
</div>
