@model Okafor_.NET.Models.Doctor

@{
    ViewData["Title"] = "Remove a doctor";
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">Doctor</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">Remove @Model.FullName?</h1>
    </div>
    <p class="portal-page-lede">
        They come off the care team page and can no longer be assigned to an
        appointment. Check nothing is booked with them first.
    </p>
</div>

<div class="portal-docket portal-measure">
    <div class="portal-docket__cap">
        <p class="portal-docket__ref">@Model.FullName</p>
        <p class="portal-docket__label">@Model.Specialty</p>
    </div>

    <dl class="portal-leaders portal-docket__ledger">
        <div class="portal-lead">
            <dt class="portal-lead__k">Department</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Or(Model.Department?.Name, "Not assigned")</dd>
        </div>
        <div class="portal-lead">
            <dt class="portal-lead__k">On the homepage</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@(Model.IsFeatured ? "Yes" : "No")</dd>
        </div>
    </dl>

    <form asp-action="Delete" class="portal-docket__acts">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Remove this doctor</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Keep them</a>
    </form>
</div>
