@model Okafor_.NET.Models.Department

@{
    ViewData["Title"] = Model.Name;
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">Department</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">@Model.Name</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to the departments</a>
    </div>
</div>

<div class="portal-docket portal-measure">
    <div class="portal-docket__cap">
        <p class="portal-docket__ref">@Model.Name</p>
    </div>

    <dl class="portal-leaders portal-docket__ledger">
        <div class="portal-lead">
            <dt class="portal-lead__k">Description</dt>
            <dd class="portal-lead__fill"></dd>
            <dd class="portal-lead__v">@Or(Model.Description, "Not given")</dd>
        </div>
    </dl>

    <div class="portal-docket__acts">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit this department</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Remove</a>
    </div>
</div>
