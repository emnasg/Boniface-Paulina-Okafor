@model IEnumerable<Okafor_.NET.Models.Department>

@{
    ViewData["Title"] = "Departments";
}

<div class="portal-title">
    <div class="portal-title__rule"></div>
    <p class="portal-title__eyebrow">The hospital</p>
    <div class="portal-title__row">
        <h1 class="portal-page-title">Departments</h1>
        <a asp-action="Create" class="btn btn-primary">Add a department</a>
    </div>
    <p class="portal-page-lede">
        These are what a patient chooses between when they ask for an
        appointment, so the names should mean something to them.
    </p>
</div>

@if (!Model.Any())
{
    <div class="portal-empty">
        <div class="portal-fleuron"><span></span></div>
        <p class="portal-empty__h">No departments have been added</p>
        <p class="portal-empty__p">
            Until there is at least one, the booking form on the public site has
            nothing for a patient to choose.
        </p>
        <a asp-action="Create" class="btn btn-primary">Add the first department</a>
    </div>
}
else
{
    <div class="portal-register portal-register--titled portal-register--brief">
        <div class="portal-register__cap">
            <h2 class="portal-register__capt">Register of departments</h2>
            <p class="portal-register__capn">
                @Model.Count() @(Model.Count() == 1 ? "department" : "departments")
            </p>
        </div>

        @foreach (var department in Model)
        {
            <div class="portal-register__row">
                <div class="min-w-0">
                    <p class="portal-register__what">@department.Name</p>
                    @if (!string.IsNullOrWhiteSpace(department.Description))
                    {
                        <p class="portal-register__meta">@department.Description</p>
                    }
                </div>

                <div class="portal-register__acts">
                    <a asp-action="Details" asp-route-id="@department.Id" class="portal-act">Read</a>
                    <a asp-action="Edit" asp-route-id="@department.Id" class="portal-act">Edit</a>
                    <a asp-action="Delete" asp-route-id="@department.Id" class="portal-act portal-act--grave">Remove</a>
                </div>
            </div>
        }
    </div>
}
